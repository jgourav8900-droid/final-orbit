# Orbit Overload - Example Environment Template
# Duplicate this file to .env and supply your personal API keys & secrets.
# Generate JWT_SECRET with: python -c "import secrets; print(secrets.token_urlsafe(48))"
GEMINI_API_KEY=your_gemini_api_key_here
NASA_API_KEY=your_nasa_api_key_here
JWT_SECRET=
JWT_EXPIRATION_SECONDS=3600
HOST=0.0.0.0
PORT=8000
DEBUG=False
DATABASE_URL=sqlite:///./orbit_overload.db
# Optional. Set a unique random token to enable the protected ML training endpoint.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ML_TRAINING_TOKEN=
