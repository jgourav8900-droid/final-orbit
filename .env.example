# Orbit Overload - Example Environment Template
# Duplicate this file to .env and supply your personal API keys & secret
GEMINI_API_KEY=your_gemini_api_key_here
NASA_API_KEY=your_nasa_api_key_here
JWT_SECRET=your_random_32_character_jwt_secret_here
JWT_EXPIRATION_SECONDS=3600
HOST=0.0.0.0
PORT=8000
DEBUG=False
DATABASE_URL=sqlite:///./orbit_overload.db
