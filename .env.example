# Copy to .env and set all production secrets before using Docker Compose.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
GEMINI_API_KEY=your_gemini_api_key_here
NASA_API_KEY=your_nasa_api_key_here
JWT_SECRET=
JWT_EXPIRATION_SECONDS=3600
HOST=127.0.0.1
PORT=8000
DEBUG=False
DATABASE_URL=sqlite:///./orbit_overload.db
# Optional token protecting model training.
ML_TRAINING_TOKEN=
# Required to enable /metrics. Use the same token in monitoring/metrics-token.
METRICS_TOKEN=
# Restrict these to the actual browser origin and reverse-proxy host in production.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Docker Compose PostgreSQL settings (use URL-safe random passwords).
POSTGRES_DB=orbit
POSTGRES_USER=orbit
POSTGRES_PASSWORD=
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8000
PROMETHEUS_PORT=9090
